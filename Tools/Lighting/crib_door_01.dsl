(event EventTick (DeltaSeconds)
  (if (Networking|IsStandalone)
    (bind pawn (Game|GetPlayerPawn 0))
    (bind cast (Utilities|Casting|CastToBP_VRBodyCharacer pawn)
      (:then
        (bind hand (Class|BPVRBodyCharacer|GetRightController cast))
        (bind pc (Game|GetPlayerController 0))
        (bind down (or (> (Game|Player|GetInputAnalogKeyState pc "OculusTouch_Right_Grip_Axis") 0.5) (Game|Player|IsInputKeyDown pc "OculusTouch_Right_Grip_Click")))
        (bind pos (Transformation|GetWorldLocation hand))
        (bind handle (Math|Transform|TransformLocation (Transformation|GetWorldTransform (Variables|Default|GetSMLever)) "23.5,-87,110.4"))
        (bind distance (Math|Vector|Distance(Vector) pos handle))
        (if (and down (not (Variables|Default|GetGripWasDown)))
          (Development|PrintString :InString "WMCYN Crib Door 01: right grip input detected" :bPrintToScreen false))
        (if (Variables|Default|GetGripHeld)
          (if (and down (and (MotionController|IsTracked hand) (< distance 120.0)))
            (Class|CompDrag|AdjustPositiontoReferenceLocation :self (Variables|Default|GetCompDrag) :InteractingActor pawn :Location pos :RotationDelta "0,0,0" :DeltaTime DeltaSeconds :TakeLocationForRotationReference true)
            (else
              (Class|CompDrag|ReleaseDrag (Variables|Default|GetCompDrag))
              (Variables|Default|SetGripHeld false)
              (Development|PrintString :InString "WMCYN Crib Door 01: released" :bPrintToScreen false)))
          (else
            (if (and down (and (MotionController|IsTracked hand) (< distance 35.0)))
              (Class|CompDrag|InitiateDrag (Variables|Default|GetCompDrag) pos)
              (Variables|Default|SetGripHeld true)
              (Development|PrintString :InString "WMCYN Crib Door 01: right grip attached" :bPrintToScreen true))))
        (Variables|Default|SetGripWasDown down)))))
